<UserControl x:Class="SglDesigner.PropertyPanels.LabelPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner"
             xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>
        <panels:BasePropertyPanel />
        <TextBlock Text="文本内容与样式" Style="{StaticResource PropHeader}"/>

        <StackPanel Margin="2">
            <TextBlock Text="标签文本 (text)" Foreground="Gray" Margin="0 2 0 2"/>
            <TextBox Height="24" VerticalContentAlignment="Center" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="文字颜色 (color)" Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:ColorPicker SelectedColor="{Binding TextColor}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="字体选择 (font)" Foreground="Gray" Margin="0 2 0 2"/>
                <ComboBox SelectedValue="{Binding FontName}" 
                          ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontOptions}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="文本对齐 (align)" Foreground="Gray" Margin="0 2 0 2"/>
                <ComboBox SelectedIndex="{Binding TextAlign}" 
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AlignOptions}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="旋转角度 (rotation)" Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown Value="{Binding TextRotation}" Minimum="0" Maximum="360"/>
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="位置偏移 (Offset)" Style="{StaticResource PropHeader}"/>
        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="偏移 X (offset_x)" Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown Value="{Binding OffsetX}" Minimum="-128" Maximum="127"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="偏移 Y (offset_y)" Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown  Height="24" Value="{Binding OffsetY}" Minimum="-128" Maximum="127"/>
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>