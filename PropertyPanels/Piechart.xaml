<UserControl x:Class="SglDesigner.PropertyPanels.PiechartPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner" 
             xmlns:base="clr-namespace:SglDesigner.PropertyPanels" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DarkGray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,8,2,2"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!--<base:BasePropertyPanel />-->

        <TextBlock Text="核心渲染 (Shape &amp; Render)" Style="{StaticResource PropHeader}"/>
        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="起始角度" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding StartAngle}" Minimum="0" Maximum="360"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="内径比例 (%)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding InnerRadiusRate}" Minimum="0" Maximum="100"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="固定外径 (radius)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding RadiusOut}" Minimum="0" ToolTip="0为自动计算"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="不透明度 (alpha)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsSmooth}" Content="平滑抗锯齿" Margin="2,5,15,0"/>
            <CheckBox IsChecked="{Binding OpenAnimEnable}" Content="加载动画"/>
        </StackPanel>

        <TextBlock Text="图例布局 (Legend Layout)" Style="{StaticResource PropHeader}"/>
        <CheckBox IsChecked="{Binding LegendEnable}" Content="显示图例 (Enable Legend)" Margin="2"/>

        <StackPanel IsEnabled="{Binding LegendEnable}">
            <UniformGrid Columns="2">
                <StackPanel Margin="2">
                    <TextBlock Text="显示位置" Foreground="Gray" />
                    <ComboBox SelectedItem="{Binding LegendPos}" 
                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:SglPieLegendPos}}}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="排列方向" Foreground="Gray" />
                    <ComboBox SelectedItem="{Binding LegendDir}" 
                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:SglPieLegendDir}}}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="图例区大小" Foreground="Gray" />
                    <xctk:IntegerUpDown Value="{Binding LegendAreaSize}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="色块大小" Foreground="Gray" />
                    <xctk:IntegerUpDown Value="{Binding LegendBoxSize}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="内边距 (Padding)" Foreground="Gray" />
                    <xctk:IntegerUpDown Value="{Binding LegendPadding}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="间距 (Item Gap)" Foreground="Gray" />
                    <xctk:IntegerUpDown Value="{Binding LegendItemGap}"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="图例样式与字体" Style="{StaticResource SubHeader}"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="2">
                    <TextBlock Text="文本颜色" Foreground="Gray" />
                    <xctk:ColorPicker SelectedColor="{Binding LegendTextColor}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="背景颜色" Foreground="Gray" />
                    <xctk:ColorPicker SelectedColor="{Binding LegendBgColor}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="字体选择" Foreground="Gray" />
                    <ComboBox SelectedValue="{Binding FontName}" 
                              ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontOptions}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="边框颜色" Foreground="Gray" />
                    <xctk:ColorPicker SelectedColor="{Binding LegendBorderColor}"/>
                </StackPanel>
            </UniformGrid>
            <CheckBox IsChecked="{Binding LegendBgEnable}" Content="绘制图例背景" Margin="2,5,0,0"/>
        </StackPanel>

        <TextBlock Text="切片数据 (Data Slices)" Style="{StaticResource PropHeader}"/>
        <ItemsControl ItemsSource="{Binding Slices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#33AAAAAA" BorderThickness="0,0,0,1" Padding="2" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <xctk:ColorPicker SelectedColor="{Binding Color}" Width="80" Margin="2" 
                                      Background="#2D2D2D" BorderBrush="#444444"/>

                            <TextBox Grid.Column="1" Height="24" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="2" VerticalAlignment="Center" Background="#2D2D2D" Foreground="White"
                             BorderBrush="#444444"/>

                            <xctk:IntegerUpDown Grid.Column="2" Height="24" Value="{Binding Value}" Margin="2"
                                        Background="#2D2D2D" Foreground="White" BorderBrush="#444444"/>

                            <Button Grid.Column="3" Content="×" Background="#444444" Foreground="Red" 
                            FontWeight="Bold" Width="20" BorderThickness="0"
                            Command="{Binding DataContext.DeleteSliceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="+ 添加新切片 (Add Slice)" Margin="5" Background="#444444"
                Command="{Binding AddSliceCommand}" 
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White"/>
    </StackPanel>
</UserControl>