<UserControl x:Class="SglDesigner.PropertyPanels.ViewlistPropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:base="clr-namespace:SglDesigner.PropertyPanels"
             Width="236">
    <StackPanel>
        <base:BasePropertyPanel />

        <TextBlock Text="列表项设置" Style="{StaticResource PropHeader}"/>
        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="项高度" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding ItemHeight}" Minimum="8" Maximum="200"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="水平边距" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding MarginX}" Minimum="0" Maximum="50"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="垂直边距" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding MarginY}" Minimum="0" Maximum="50"/>
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
