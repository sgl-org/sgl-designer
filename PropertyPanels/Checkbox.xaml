<UserControl x:Class="SglDesigner.PropertyPanels.CheckboxPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner"
             xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>

        <panels:BasePropertyPanel />
        <TextBlock Text="复选框特有属性" Style="{StaticResource PropHeader}"/>

        <StackPanel Margin="2">
            <TextBlock Text="显示文本 (text)" Foreground="Gray" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="当前状态 (status)" Foreground="Gray" />
            <CheckBox IsChecked="{Binding Status}" Content="已选中" Foreground="White" Margin="0,5"/>
        </StackPanel>
        <UniformGrid Columns="2">
            

            <StackPanel Margin="2">
                <TextBlock Text="文本颜色 (color)" Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding TextColor}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="字体选择 (font)" Foreground="Gray" />
                <ComboBox SelectedValue="{Binding FontName}" 
                          ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontOptions}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="不透明度 (alpha)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>
        </UniformGrid>
        
    </StackPanel>
</UserControl>