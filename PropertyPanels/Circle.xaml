<UserControl x:Class="SglDesigner.PropertyPanels.CirclePropertyPanel"
             xmlns:local="clr-namespace:SglDesigner" 
             xmlns:base="clr-namespace:SglDesigner.PropertyPanels" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>
        <!--<base:BasePropertyPanel />-->

        <TextBlock Text="圆形属性" Style="{StaticResource PropHeader}"/>

        

        <UniformGrid Columns="2" Margin="0,5,0,0">

            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="半径" Foreground="Gray" />
                    <TextBlock Text=" (radius)" Foreground="#FF999999"/>
                </StackPanel>
                <xctk:IntegerUpDown Value="{Binding Radius}" Minimum="0" Maximum="500"/>
            </StackPanel>
            
            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="填充颜色" Foreground="Gray" />
                    <TextBlock Text=" (color)" Foreground="#FF999999"/>
                </StackPanel>
                <xctk:ColorPicker SelectedColor="{Binding Color}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="边框颜色"  Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:ColorPicker SelectedColor="{Binding BorderColor}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="边框大小"  Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown Value="{Binding BorderWidth}" Minimum="0" Maximum="16"/>
            </StackPanel>
            <StackPanel Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="透明度" Foreground="Gray" />
                    <TextBlock Text=" (alpha)" Foreground="#FF999999" />
                </StackPanel>
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>
        </UniformGrid>

        

        <TextBlock Text="扩展" Style="{StaticResource PropHeader}"/>
        <StackPanel Margin="2">
            <TextBlock Text="图像变量 (pixmap)" Foreground="Gray" />
            <ComboBox SelectedValue="{Binding PixmapVarName}" 
SelectedValuePath="Name"
ItemsSource="{Binding Source={x:Static local:ImageViewModel.Instance}, Path=ImageOptions}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,5,0"
             Source="{Binding Name, Converter={StaticResource ResNameToImageSourceConverter}}"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </StackPanel>
</UserControl>