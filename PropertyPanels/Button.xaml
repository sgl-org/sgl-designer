<UserControl x:Class="SglDesigner.PropertyPanels.ButtonPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner" 
             xmlns:base="clr-namespace:SglDesigner.PropertyPanels" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>


        <base:BasePropertyPanel />
        <TextBlock Text="按钮文本设置" Style="{StaticResource PropHeader}"/>

        <StackPanel Margin="2">
            <TextBlock Text="按钮文本 (text)" Foreground="Gray" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="文本颜色 (text_color)" Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding TextColor}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="字体选择 (font)" Foreground="Gray" />
                <ComboBox SelectedValue="{Binding FontName}" 
                          ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontOptions}"/>
            </StackPanel>

            <!--<StackPanel Margin="2">
                <TextBlock Text="文本对齐 (align)" Foreground="Gray" />
                <ComboBox SelectedValue="{Binding TextAlign}" 
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AlignOptions}"/>
            </StackPanel>-->
        </UniformGrid>

        <!--<TextBlock Text="按钮事件回调" Style="{StaticResource PropHeader}"/>
        <panels:EventListPanel />-->
    </StackPanel>
</UserControl>