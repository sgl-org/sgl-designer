<UserControl x:Class="SglDesigner.PropertyPanels.PolygonPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner"
         xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>
        <TextBlock Text="多边形样式" Style="{StaticResource PropHeader}"/>

        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="填充颜色" Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding FillColor}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="描边颜色" Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding PolygonBorderColor}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="描边宽度" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding PolygonBorderWidth}" Minimum="0" Maximum="20"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="不透明度 (0-255)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="文本设置" Style="{StaticResource PropHeader}"/>
        <StackPanel Margin="2">
            <TextBlock Text="显示文本" Foreground="Gray" />
            <TextBox  Height="24" VerticalContentAlignment="Center"  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="White" Margin="0,2"/>
        </StackPanel>
        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="文字颜色 (color)" Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:ColorPicker SelectedColor="{Binding TextColor}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="字体选择 (font)" Foreground="Gray" Margin="0 2 0 2"/>
                <ComboBox SelectedValue="{Binding FontName}" 
                  ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontOptions}"/>
            </StackPanel>

        </UniformGrid>

        <TextBlock Text="顶点坐标 (Vertices)" Style="{StaticResource PropHeader}"/>
        <Border Background="#2D2D2D" CornerRadius="4" Padding="5" Margin="2">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Vertices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="2,0"/>
                                <xctk:IntegerUpDown Grid.Column="1" Value="{Binding X, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="2" Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="5,0,2,0"/>
                                <xctk:IntegerUpDown Grid.Column="3" Value="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="4" Content="×" Width="20" Margin="5,0,0,0" 
                                        Click="RemoveVertex_Click" Background="#440000" Foreground="White"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ 添加顶点" Margin="0,10,0,5" Click="AddVertex_Click" Height="25"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>