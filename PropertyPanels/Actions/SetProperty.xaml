<UserControl x:Class="SglDesigner.PropertyPanels.Actions.SetProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SglDesigner"
             mc:Ignorable="d" d:Width="215" d:Height="145">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <UniformGrid Columns="2">
        <StackPanel Margin="2">
            <TextBlock Text="目标对象 ID" Foreground="Gray" />
            <ComboBox
              ItemsSource="{Binding Source={x:Static local:SglScreen.Instance},Path=AllWidgetsFlat}"
              SelectedValue="{Binding Target}" SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Type,StringFormat='-{0}'}" Foreground="DeepSkyBlue" FontSize="10"  VerticalAlignment="Center"/>
                            
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="属性" Foreground="Gray" />
            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SglPropertyTypes}" 
                      SelectedItem="{Binding PropertyType}"/>


        </StackPanel>
        
        <StackPanel Margin="2">
            <TextBlock Text="值" Foreground="Gray" />
            <TextBox Text="{Binding Value}"/>
        </StackPanel>
    </UniformGrid>
</UserControl>
