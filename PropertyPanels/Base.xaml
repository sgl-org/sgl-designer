<UserControl x:Class="SglDesigner.PropertyPanels.BasePropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    
    <UniformGrid Columns="2">
        <StackPanel Margin="2">
            <TextBlock Text="背景颜色"  Foreground="Gray" Margin="0 2 0 2"/>
            <xctk:ColorPicker SelectedColor="{Binding BgColor}"/>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="边框颜色"  Foreground="Gray" Margin="0 2 0 2"/>
            <xctk:ColorPicker SelectedColor="{Binding BorderColor}"/>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="边框大小"  Foreground="Gray" Margin="0 2 0 2"/>
            <xctk:IntegerUpDown Value="{Binding BorderWidth}" Minimum="0" Maximum="16"/>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="圆角大小"  Foreground="Gray" Margin="0 2 0 2"/>
            <xctk:IntegerUpDown Value="{Binding Radius}" Minimum="0"/>
        </StackPanel>
        <StackPanel Margin="2">
            <TextBlock Text="不透明度 (0-255)"  Foreground="Gray" Margin="0 2 0 2"/>
            <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
        </StackPanel>
    </UniformGrid>
</UserControl>