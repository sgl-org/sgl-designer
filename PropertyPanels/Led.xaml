<UserControl x:Class="SglDesigner.PropertyPanels.LedPropertyPanel"
             xmlns:local="clr-namespace:SglDesigner"
             xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>

        <!--<panels:BasePropertyPanel />-->
        <TextBlock Text="LED 设置" Style="{StaticResource PropHeader}"/>

        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="LED半径"  Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown Value="{Binding Radius}" Height="24" Minimum="0" Maximum="50"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="背景颜色(bg_color)"   Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:ColorPicker SelectedColor="{Binding BgColor}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="亮灯颜色 (on_color)"   Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding OnColor}"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="灭灯颜色 (off_color)" Foreground="Gray" />
                <xctk:ColorPicker SelectedColor="{Binding OffColor}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="不透明度 (0-255)"  Foreground="Gray" Margin="0 2 0 2"/>
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>

        </UniformGrid>
        <StackPanel Margin="2">
            <TextBlock Text="亮灯状态 (status)" Foreground="Gray" />
            <CheckBox IsChecked="{Binding Status}" Content="点亮" Foreground="White" VerticalAlignment="Center" Margin="0,5"/>
        </StackPanel>
        
    </StackPanel>
</UserControl>