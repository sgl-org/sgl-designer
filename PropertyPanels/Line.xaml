<UserControl x:Class="SglDesigner.PropertyPanels.LinePropertyPanel"
             xmlns:local="clr-namespace:SglDesigner"
             xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel>

        <!--<panels:BasePropertyPanel />-->
        <TextBlock Text="线条属性" Style="{StaticResource PropHeader}"/>

        <UniformGrid Columns="2">
            <StackPanel Margin="2">
                <TextBlock Text="线条颜色" Foreground="Gray" />
                <xctk:ColorPicker  SelectedColor="{Binding Color}"/>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock Text="线条宽度" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding LineWidth}" Minimum="1" Maximum="20"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="不透明度 (alpha)" Foreground="Gray" />
                <xctk:IntegerUpDown Value="{Binding Opacity}" Minimum="0" Maximum="255"/>
            </StackPanel>

            <StackPanel Margin="2">
                <TextBlock Text="线条方向 (direction)" Foreground="Gray" />
                <ComboBox SelectedValue="{Binding Direction}" 
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=LineDirectionOptions}"/>
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>