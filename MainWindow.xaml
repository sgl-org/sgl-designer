<Window x:Class="SglDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:panels="clr-namespace:SglDesigner.PropertyPanels"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        xmlns:local="clr-namespace:SglDesigner"
        
        Title=" SGL Designer" Height="800" Width="1280" Background="#1E1E1E" Loaded="Window_Loaded">
    <Window.Resources>
        <local:TreeViewLineConverter x:Key="LineConverter"/>
        <FontFamily x:Key="DefaultConsolas">
            pack://application:,,,/SglDesigner;component/Resources/Fonts/#Consolas
        </FontFamily>

        <ContextMenu x:Key="ResourceItemContextMenu">
            <MenuItem Header="修改" Click="OnEditResource">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResType}" Value="{x:Static local:SglResType.FontCSource}">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator />

            <MenuItem Header="删除" Click="OnDeleteResource" Foreground="Red"/>
        </ContextMenu>

        <ContextMenu x:Key="ScreenItemContextMenu">
            <MenuItem Header="重命名" Click="OnEditScreenName">
            </MenuItem>
            <Separator />

            <MenuItem Header="删除" Click="OnDeleteScreen" Foreground="Red"/>
        </ContextMenu>

        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="15" Height="13" SnapsToDevicePixels="True">
                            <Rectangle Width="9" Height="9" Stroke="#919191" SnapsToDevicePixels="true">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,2" StartPoint="0.5,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="Silver" Offset="0.5"/>
                                        <GradientStop Color="LightGray" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="ExpandPath" Width="1" Height="5" Stroke="Black" SnapsToDevicePixels="true"/>
                            <Rectangle Width="5" Height="1" Stroke="Black" SnapsToDevicePixels="true"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Visibility"  TargetName="ExpandPath" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <PathGeometry x:Key="EyeOpenIcon">M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z</PathGeometry>
        <PathGeometry x:Key="EyeClosedIcon">M250.48125 89.2875C282.375 117.75 300 150 300 150S243.75 253.125 150 253.125A131.25 131.25 0 0 1 97.6875 242.1L112.125 227.64375A112.5 112.5 0 0 0 150 234.375C189.75 234.375 222.73125 212.475 246.9 188.30625A243.75 243.75 0 0 0 278.025 150Q276.4125 147.5625 274.36875 144.6C268.0875 135.6 258.80625 123.6 246.9 111.69375Q242.26875 107.04375 237.20625 102.58125zM211.81875 127.95A65.625 65.625 0 0 1 127.93125 211.8375L143.3625 196.40625A46.875 46.875 0 0 0 196.40625 143.3625zM156.6375 103.59375L172.05 88.18125A65.625 65.625 0 0 0 88.1625 172.06875L103.59375 156.6375A46.875 46.875 0 0 1 156.6375 103.59375M62.8125 197.4375Q57.75 192.9375 53.1 188.30625A243.75 243.75 0 0 1 21.975 150L25.63125 144.6C31.9125 135.6 41.19375 123.6 53.1 111.69375C77.26875 87.525 110.26875 65.625 150 65.625C163.425 65.625 176.0625 68.11875 187.875 72.375L202.3125 57.9A131.25 131.25 0 0 0 150 46.875C56.25 46.875 0 150 0 150S17.60625 182.26875 49.51875 210.7125L62.79375 197.41875zM255.8625 30.8625L30.8625 255.8625L44.1375 269.1375L269.1375 44.1375z</PathGeometry>
        <!-- TreeViewItem -->
        <Style x:Key="{x:Type TreeViewItem}" TargetType="{x:Type TreeViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="20" Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Connecting Lines -->
                            <Rectangle x:Name="VerLn" 
           Width="1" 
           Stroke="#DCDCDC" 
           Fill="#DCDCDC"
           Grid.Column="0" 
           Grid.RowSpan="2" 
           HorizontalAlignment="Center" 
           SnapsToDevicePixels="true"/>

                            <Rectangle x:Name="HorLn" 
           Height="1" 
           Stroke="#DCDCDC" 
           Grid.Column="0"
           VerticalAlignment="Center"
           Margin="10,0,0,0" 
           SnapsToDevicePixels="True"/>

                            <ToggleButton Margin="0,0,0,0" x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}" IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <Border Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" MinWidth="20"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <!-- This trigger changes the connecting lines if the item is the last in the list -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource LineConverter}}" Value="true">
                                <Setter TargetName="VerLn" Property="Height" Value="12"/>
                                <Setter TargetName="VerLn" Property="VerticalAlignment" Value="Top"/>
                            </DataTrigger>
                            <Trigger Property="IsExpanded" Value="false">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasHeader" Value="false"/>
                                    <Condition Property="Width" Value="Auto"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Header" Property="MinWidth" Value="75"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasHeader" Value="false"/>
                                    <Condition Property="Height" Value="Auto"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Header" Property="MinHeight" Value="19"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="IsSelectionActive" Value="false"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#b59047"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem" x:Key="DarkMenuItemStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot" 
                        Background="#2D2D2D" 
                        BorderBrush="Transparent" 
                        BorderThickness="1" 
                        SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#2D2D2D"  Margin="1"/>

                                <ContentPresenter ContentSource="Icon" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Width="16" Height="16" />

                                <ContentPresenter Grid.Column="1" 
                                          ContentSource="Header" 
                                          Margin="10,5,20,5" 
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" >
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="WidgetMenu" >
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                    <Style.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2D2D2D"/>
                    </Style.Resources>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#3E3E42"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Background="{TemplateBinding Background}" Height="1" Margin="25,2,0,2"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="克隆 (Ctrl+D)" Click="CloneSelected_Click"/>
            <Separator/>
            <MenuItem Header="置于顶层" Click="BringToFront_Click"/>
            <MenuItem Header="置于底层" Click="SendToBack_Click"/>
            <Separator/>
            <MenuItem Header="删除 (Del)" Click="DeleteSelected_Click"/>
        </ContextMenu>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="280"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="280" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Background="#2D2D2D">
            <Menu>
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="新建工程" Click="ResetView_Click" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="打开工程..." Click="LoadProject_Click" InputGestureText="Ctrl+O"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="保存工程" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="另存为..." Click="SaveProject_Click"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="导出 C 代码" Click="ExportCode_Click"  InputGestureText="F5"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="退出" Click="Exit_Click" InputGestureText="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="编辑(_E)">
                    <MenuItem Header="撤销" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="重做" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="克隆选中项" Click="CloneSelected_Click" InputGestureText="Ctrl+D"/>
                    <MenuItem Header="删除" Click="DeleteSelected_Click" InputGestureText="Del"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="全选" InputGestureText="Ctrl+A"/>
                </MenuItem>

                <MenuItem Header="对齐(_A)">
                    <MenuItem Header="左对齐" Click="Align_Click" Tag="Left"/>
                    <MenuItem Header="水平居中" Click="Align_Click" Tag="CenterX"/>
                    <MenuItem Header="右对齐" Click="Align_Click" Tag="Right"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="顶对齐" Click="Align_Click" Tag="Top"/>
                    <MenuItem Header="垂直居中" Click="Align_Click" Tag="CenterY"/>
                    <MenuItem Header="底对齐" Click="Align_Click" Tag="Bottom"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="水平等距分布" Click="Align_Click" Tag="DistH"/>
                    <MenuItem Header="垂直等距分布" Click="Align_Click" Tag="DistV"/>
                </MenuItem>

                <MenuItem Header="视图(_V)">
                    <MenuItem Header="重置缩放" Click="ZoomToFit_Click" InputGestureText="Ctrl+0"/>
                    <MenuItem Header="显示网格" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="显示标尺" IsCheckable="True" IsChecked="True"/>
                </MenuItem>

                <MenuItem Header="关于(_H)">
                    <MenuItem Header="查看文档"/>
                    <MenuItem Header="检查更新" Click="CheckUpdate_Click"/>
                    <MenuItem Header="添加到用户环境变量(强烈推荐)" Click="AddToEnvButton_Click"/>
                    <MenuItem Header="关于 SGL Designer" Click="About_Click"/>
                </MenuItem>
            </Menu>

            <Border Background="#333333" Height="35" BorderBrush="#111111" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="29*"></ColumnDefinition>
                        <ColumnDefinition Width="200"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                        <Button Content="新建" Click="NewProject_Click" Width="60" Height="24" Margin="5,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Button Content="打开" Click="LoadProject_Click" Width="60" Height="24" Margin="2,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Button Content="保存" Click="SaveProject_Click" Width="60" Height="24" Margin="2,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Button Content="工程设置" Click="SetProject_Click" Width="60" Height="24" Margin="2,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Separator Margin="5,8" Background="#555"/>
                        <CheckBox x:Name="SnapToggle" Content="吸附" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                        <xctk:IntegerUpDown x:Name="GridSizeInput" Value="4" Width="45" Height="22" Background="#3D3D3D" Foreground="White" Margin="5,0" />
                        <Separator Margin="10,8" Background="#555"/>
                        <Button Content="删除" Click="DeleteSelected_Click" Width="60" Height="24" Background="#A33" Foreground="White" BorderThickness="0" />
                        <Button Content="复位" Click="ZoomToFit_Click" Width="60" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <!--<Button Content="生成代码" Click="GenerateCode_Click" Width="60" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />-->
                        <Button Content="导出代码" Click="ExportCode_Click" Width="60" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Button Content="编译" Click="ExportBuild_Click" Width="60" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                        <Button Content="运行" Click="ExportRun_Click" Width="60" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" >
                        <Button Content="SGL参数配置" Click="SglConfig_Click" Width="80" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />

                        <Button Content="拉取SGL代码" Click="ExportGitPull_Click" Width="80" Height="24" Margin="10,0" Background="#3D3D3D" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Focusable="True"  Background="#252526">
            <Grid.RowDefinitions>
                <RowDefinition Height="80*"/>
                <RowDefinition Height="150*"/>
                <RowDefinition Height="143*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="5,5,5,5">
                <TextBlock DockPanel.Dock="Top" Text="屏幕列表" Foreground="#FFD700"  />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,5">
                    <Button x:Name="BtnAddScreen" Content="+" Width="30" Click="BtnAddScreen_Click" Height="24" Margin="0,0,5,0" Background="#333" Foreground="White">

                    </Button>
                    <Button x:Name="BtnDelScreen" Content="-" Width="30" Click="BtnDelScreen_Click"  Height="24" Background="#333" Foreground="White"/>
                    <Label Content="(双击或者右键可修改名称)" Foreground="LightGray"></Label>
                </StackPanel>

                <ListBox ScrollViewer.VerticalScrollBarVisibility="Auto"  x:Name="ScreenListBox"  ContextMenu="{StaticResource ScreenItemContextMenu}"
         ItemsSource="{Binding ScreenList}" MouseDoubleClick="ScreenListBox_MouseDoubleClick" 
         SelectedItem="{Binding SelectedScreen}" HorizontalContentAlignment="Stretch" 
         Background="#1A1A1A" BorderBrush="DarkSlateGray"  BorderThickness="1"
                             
                 dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                             >
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid >
                                <TextBlock Text="{Binding Id}" VerticalAlignment="Center" Foreground="#CCC"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>

                                <TextBox BorderThickness="1"  VerticalContentAlignment="Center" VerticalAlignment="Center" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}"
                         GotFocus="TextBox_GotFocus"
                         LostFocus="TextBox_LostFocus"
                         KeyDown="TextBox_KeyDown"
                                                 IsVisibleChanged="TextBox_IsVisibleChanged"
                          Foreground="Green" BorderBrush="#FFD700"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>


            <DockPanel Grid.Row="1" Margin="5,5,5,5">
                <TextBlock Text="控件库" DockPanel.Dock="Top" Foreground="#FFD700"  />
                <ScrollViewer  VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Orientation="Vertical" >



                        <UniformGrid Columns="4" Margin="5 0 5 0">
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Button" Click="AddButton_Click"
            Tag="M2,4 H14 V12 H2 Z M5,8 H11"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Label" Click="AddLabel_Click"
            Tag="M2,13 L6,3 L10,13 M4,10 H8 M11,7 V13 M11,10 A2.5,2.5 0 1,1 11,10.1"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Progress" Click="AddProgress_Click"
            Tag="M2,6 H14 V10 H2 Z M5,6 V10 M8,6 V10"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Bar" Click="AddBar_Click"
            Tag="M2,6 H14 V10 H2 Z M4,7 H12 V9 H4 Z"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="CheckBox" Click="AddCheckBox_Click"
            Tag="M5.5,5.5 H10.5 V10.5 H5.5 Z M7,8 L8,9 L10,6"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Switch" Click="AddSwitch_Click"
            Tag="M176,60H80a68,68,0,0,0,0,136h96a68,68,0,0,0,0-136Zm0,128H80A60,60,0,0,1,80,68h96a60,60,0,0,1,0,120ZM80,92a36,36,0,1,0,36,36A36,36,0,0,0,80,92Zm0,64a28,28,0,1,1,28-28A28,28,0,0,1,80,156Z"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="LED" Click="AddLed_Click"
            Tag="M8,5 A3,3 0 1,0 8,11 A3,3 0 0,0 8,5 Z M8,1 V3 M8,13 V15 M1,8 H3 M13,8 H15 M3,3 L5,5 M11,11 L13,13 M3,13 L5,11 M11,5 L13,3"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Arc" Click="AddArc_Click"
            Tag="M3,13 A10,10 0 0,1 13,3"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Slider" Click="AddSlider_Click"
            Tag="M2,5 H7 M11,5 H14 M9,3 A2,2 0 1,0 9,7 A2,2 0 0,0 9,3 Z 
                M2,11 H5 M9,11 H14 M7,9 A2,2 0 1,0 7,13 A2,2 0 0,0 7,9 Z"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="TextBox" Click="AddTextBox_Click"
            Tag="M 112 42 a 6 6 0 0 0 -6 6 V 66 H 24 A 14 14 0 0 0 10 80 v 96 a 14 14 0 0 0 14 14 h 82 v 18 a 6 6 0 0 0 12 0 V 48 A 6 6 0 0 0 112 42 Z M 24 178 a 2 2 0 0 1 -2 -2 V 80 a 2 2 0 0 1 2 -2 h 82 V 178 Z M 246 80 v 96 a 14 14 0 0 1 -14 14 H 144 a 6 6 0 0 1 0 -12 h 88 a 2 2 0 0 0 2 -2 V 80 a 2 2 0 0 0 -2 -2 H 144 a 6 6 0 0 1 0 -12 h 88 A 14 14 0 0 1 246 80 Z M 86 112 a 6 6 0 0 1 -6 6 H 70 v 26 a 6 6 0 0 1 -12 0 V 118 H 48 a 6 6 0 0 1 0 -12 H 80 A 6 6 0 0 1 86 112 Z"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Line" Click="AddLine_Click"
            Tag="M2,14 L14,2"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Dropdown" Click="AddDropdown_Click"
            Tag="M 1 4 H 15 V 12 H 1 Z M 9 7 L 11 9 L 13 7"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Roller" Click="AddRoller_Click"
            Tag="M 2 3 H 14 V 13 H 2 Z M 6 5 L 10 5 M 6 8 L 10 8 M 6 11 L 10 11"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Polygon" Click="AddPolygon_Click"
            Tag="M8,2 L14,6 L12,13 H4 L2,6 Z"/>



                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Circle" Click="AddCircle_Click"
            Tag="M3,8 A5,5 0 1,0 13,8 A5,5 0 1,0 3,8"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Ring" Click="AddRing_Click"
            Tag="M3,8 A5,5 0 1,0 13,8 A5,5 0 1,0 3,8 M5,8 A3,3 0 1,0 11,8 A3,3 0 1,0 5,8"/>


                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="5 5 5 5">
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Panel" Click="AddPanel_Click"
    Tag="M2,2 H10 V10 H2 Z M6,6 H14 V14 H6 Z"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Box" Click="AddBox_Click"
    Tag="M2,2 H14 V14 H2 Z M10,4 H12 V10 H10 Z M4,10 H10 V12 H4 Z"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Win" Click="AddWin_Click"
    Tag="M2,4 H14 V14 H2 Z M2,4 H14 V8 H2 Z M12,5 A1.5,1.5 0 1,0 12,5.1"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Status" Click="AddStatusbar_Click"
    Tag="M2,2 H14 V14 H2 Z M4,6 H12 M4,9 H10 M4,12 H8"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="ViewList" Click="AddViewlist_Click"
    Tag="M2,3 H14 V13 H2 Z M2,3 H14 V6 H2 Z M4,9 H12 M4,12 H12"/>
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="5 0 5 0">
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="MsgBox" Click="AddMsgBox_Click"
    Tag="M2,3 H14 V11 H9 L7,14 V11 H2 Z"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Keyboard" Click="AddKeyboard_Click"
    Tag="M2,5 H14 V11 H2 Z M4,7 H5 M7,7 H8 M10,7 H11 M5,9 H11"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="NumKbd" Click="AddNumberKbd_Click"
    Tag="M4,3 H7 V6 H4 Z M9,3 H12 V6 H9 Z M4,8 H7 V11 H4 Z M9,8 H12 V11 H9 Z"/>



                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="BarChart" Click="AddBarchart_Click"
        Tag="M3,13 V8 H6 V13 Z M7,13 V4 H10 V13 Z M11,13 V10 H14 V13 Z"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="PieChart" Click="AddPiechart_Click"
        Tag="M8,2 A6,6 0 1,0 14,8 H8 Z M9,2 V7 H14 A6,6 0 0,0 9,2 Z"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="LineChart" Click="AddLinechart_Click"
        Tag="M2,2 V14 H15 M4,11 L7,7 L11,10 L14,4"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Icon" Click="AddIcon_Click"
    Tag="M8,2 L10,6 L14,7 L11,10 L12,14 L8,12 L4,14 L5,10 L2,7 L6,6 Z"/>

                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="Image" Click="AddImage_Click"
    Tag="M2,4 H14 V12 H2 Z M3,11 L6,8 L9,11 L11,9 L14,12 M11,6 A1,1 0 1,1 11,6.1"/>
                            <Button Style="{StaticResource SglSlimIconButtonStyle}" Content="QRCode" Click="AddQrcode_Click"
        Tag="M3,11 H11 V3 H3 V11 Z M5,5 H9 V9 H5 V5 Z M3,21 H11 V13 H3 V21 Z M5,15 H9 V19 H5 V15 Z M13,3 V11 H21 V3 H13 Z M15,5 H19 V9 H15 V5 Z M13,13 H15 V15 H13 V13 Z M15,15 H17 V17 H15 V15 Z M17,13 H19 V15 H17 V13 Z M19,15 H21 V17 H19 V15 Z M13,17 H15 V19 H13 V17 Z M17,17 H19 V19 H17 V17 Z M15,19 H17 V21 H15 V19 Z M19,19 H21 V21 H19 V19 Z"/>

                        </UniformGrid>


                    </StackPanel>
                </ScrollViewer>
            </DockPanel>



            <DockPanel Grid.Row="2" Margin="5,5,5,5">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Grid.Row="2">
                    <TextBlock Text="控件列表" Foreground="#FFD700"  />
                    <TextBlock Text="{Binding Source={x:Static local:SglScreen.Instance}, Path=WidgetCount,StringFormat= ( {0} )}" Foreground="#FFD700"  />
                </StackPanel>

                <TreeView VirtualizingStackPanel.IsVirtualizing="True" BorderBrush="DarkSlateGray"  BorderThickness="1" ContextMenu="{StaticResource WidgetMenu}"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" ItemsSource="{Binding SelectedScreen.Widgets}" 
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True" 
                    dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    dd:DragDrop.UseDefaultDragAdorner="True"   
                    VerticalAlignment="Top"  DockPanel.Dock="Bottom"
                    SelectedItemChanged="WidgetTree_SelectedItemChanged"  Background="#1e1e1e" Name="WidgetTree">
                    <TreeView.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="0,2" HorizontalAlignment="Stretch" Width="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="White" VerticalAlignment="Center"/>

                                <CheckBox Grid.Column="1" 
                                      IsChecked="{Binding IsHidden, Mode=TwoWay}"
                                      Style="{StaticResource {x:Static ToolBar.CheckBoxStyleKey}}"
                                      Focusable="False"
                                      Margin="5,0,10,0">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Path x:Name="IconPath" 
                                              Width="16" Height="16" 
                                              Fill="White" 
                                              Stretch="Uniform" 
                                              Data="{StaticResource EyeOpenIcon}" 
                                              Cursor="Hand"/>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="IconPath" Property="Data" Value="{StaticResource EyeClosedIcon}"/>
                                                    <Setter TargetName="IconPath" Property="Fill" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IconPath" Property="Fill" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </DockPanel>


        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="#111"/>

        <Grid Grid.Row="1" Grid.Column="2" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Canvas x:Name="ViewportContainer" Focusable="True" Grid.Row="1" Grid.Column="1" Background="Transparent" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" PreviewMouseRightButtonDown="Viewport_PreviewMouseRightButtonDown" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
                <Canvas x:Name="DesignerCanvas" Focusable="True" >
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale"/>
                            <TranslateTransform x:Name="CanvasTranslate"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>


                    <Canvas x:Name="WidgetContainer" ContextMenu="{StaticResource WidgetMenu}" Width="320" Height="240"  ClipToBounds="True"/>

                    <Canvas x:Name="AdornerLayer" Background="{x:Null}"/>
                    <Canvas x:Name="HandleLayer"/>
                </Canvas>
            </Canvas>
            <Canvas x:Name="TopRuler" Grid.Row="0" Grid.Column="1" Height="25" Background="#2D2D30"/>
            <Canvas x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" Width="25" Background="#2D2D30"/>


            <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Background="#111"/>

            <TabControl Grid.Row="3" Grid.Column="0" SelectedIndex="{Binding BottomPanelTabIndex}" Grid.ColumnSpan="2" Background="#252526" BorderBrush="#333" BorderThickness="0">
                <TabItem Header="资源管理" Foreground="#FFD700" Background="Transparent" BorderThickness="0">
                    <Grid Background="#1E1E1E">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                            <Button Content="添加图片" Click="AddImageResource_Click"  Height="24" Padding="5 0 5 0" Background="#3E3E42" Foreground="White" BorderThickness="0" BorderBrush="#555"/>
                            <Separator Margin="5,0" Background="#444"/>
                            <Button Content="添加字体" Click="AddFontResource_Click"  Height="24" Padding="5 0 5 0" Background="#3E3E42" Foreground="White" BorderThickness="0" BorderBrush="#555"/>
                            <Separator Margin="5,0" Background="#444"/>
                            <Button Content="删除选中" Click="DeleteResource_Click"  Height="24" Padding="5 0 5 0" Background="#D11A2A" Foreground="White" BorderThickness="0"  BorderBrush="#800"/>
                            <Label Content="(右键可修改)" Foreground="LightGray"></Label>
                        </StackPanel>

                        <ListBox x:Name="ResourceListBox" VerticalAlignment="Top" Grid.Row="1" Background="#1A1A1A" BorderBrush="#333" 
                            ItemsSource="{Binding Source={x:Static local:SglResManager.Resources}}">
                            <ListBox.Resources>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Border Width="32" Height="32" Background="#333" CornerRadius="3" Margin="0,0,10,0">
                                            <Grid>
                                                <Image Source="{Binding Name, Converter={StaticResource ResNameToImageSourceConverter}}" 
                           Visibility="{Binding ResType, Converter={StaticResource ImgVisibleConverter}}"
                           Stretch="Uniform"/>

                                                <TextBlock Text="{Binding ResType, Converter={StaticResource ResTypeToDisplayTextConverter}}" 
                              
                               Visibility="{Binding FilePath, Converter={StaticResource FontVisibleConverter}}"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               Foreground="White" 
                               FontSize="14"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                           Foreground="#569CD6" 
                           FontWeight="Bold" 
                           FontSize="12"/>
                                            <TextBlock Text="{Binding FilePath}" 
                           Foreground="#888" 
                           FontSize="10" 
                           MaxWidth="300" 
                           TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#252525"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="ToolTip" Value="在资源上右键菜单可修改"/>

                                    <Setter Property="ContextMenu" Value="{StaticResource ResourceItemContextMenu}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A2D2E"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#094771"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="输出信息" Foreground="#FFD700" Background="Transparent">
                    <TabItem.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </TabItem.Resources>
                    <RichTextBox  x:Name="LogInfo" Margin="5,0,5,0" IsReadOnly="True" MinHeight="160"
                 Background="#1A1A1A" PreviewMouseWheel="LogInfo_PreviewMouseWheel"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top"
             HorizontalScrollBarVisibility="Disabled" BorderBrush="#333"/>
                </TabItem>
            </TabControl>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Background="#111"/>
        <TabControl Grid.Row="1" Grid.Column="4" Background="#252526" 
            SelectedIndex="{Binding RightPanelTabIndex}" 
            BorderBrush="#252526" BorderThickness="0">

            <TabItem Header="属性" Foreground="#FFD700" Background="Transparent">
                <ScrollViewer  VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Background="#252526">
                        <TextBlock Text="排列与分布" Foreground="#FFD700" Margin="10,10,0,8" />
                        <UniformGrid Columns="4" Height="50" Margin="10,0">
                            <Button Content="左" Click="Align_Click" Tag="Left" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="中X" Click="Align_Click" Tag="CenterX" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="右" Click="Align_Click" Tag="Right" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="H分布" Click="Align_Click" Tag="DistH" Margin="1" Background="#4D4D4D" Foreground="#FFD700" FontWeight="Bold"/>
                            <Button Content="顶" Click="Align_Click" Tag="Top" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="中Y" Click="Align_Click" Tag="CenterY" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="底" Click="Align_Click" Tag="Bottom" Margin="1" Background="#3D3D3D" Foreground="White" />
                            <Button Content="V分布" Click="Align_Click" Tag="DistV" Margin="1" Background="#4D4D4D" Foreground="#FFD700" FontWeight="Bold"/>
                        </UniformGrid>

                        <TextBlock Text="基本属性" Foreground="#FFD700" Margin="10,10,0,0" />
                        <Grid x:Name="PropertyPanel"
                              IsEnabled="False"
                              Margin="10 0 10 10"
                              GotKeyboardFocus="PropertyPanel_GotKeyboardFocus"
                              LostKeyboardFocus="PropertyPanel_LostKeyboardFocus"
                              PreviewMouseLeftButtonDown="PropertyPanel_PreviewMouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="2">
                                <TextBlock Text="X" Foreground="Gray" />
                                <xctk:IntegerUpDown Value="{Binding X, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}" Spinned="OnManualUIChanged"   KeyDown="OnInputKeyDown" Background="#3D3D3D" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                                <TextBlock Text="Y" Foreground="Gray" />
                                <xctk:IntegerUpDown Value="{Binding Y, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}" Spinned="OnManualUIChanged"  KeyDown="OnInputKeyDown" Background="#3D3D3D" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="2">
                                <TextBlock Text="宽" Foreground="Gray" />
                                <xctk:IntegerUpDown Value="{Binding W, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}" Spinned="OnManualUIChanged"  KeyDown="OnInputKeyDown" Background="#3D3D3D" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="2">
                                <TextBlock Text="高" Foreground="Gray" />
                                <xctk:IntegerUpDown Value="{Binding H, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}" Spinned="OnManualUIChanged"  KeyDown="OnInputKeyDown" Background="#3D3D3D" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="2,2,2,0">
                                <TextBlock Text="对象ID" Foreground="Gray" />
                                <TextBox x:Name="IdTextBox" Text="{Binding Id, UpdateSourceTrigger=Explicit}" 
                                 Background="#1A1A1A" KeyDown="IdTextBox_KeyDown" Foreground="White" 
                                 GotFocus="IdTextBox_GotFocus" LostFocus="IdTextBox_LostFocus" 
                                 BorderBrush="#333" Padding="3"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="2,2,2,0">
                                <TextBlock Text="隐藏对象" Foreground="Gray" />
                                <CheckBox IsChecked="{Binding IsHidden}" Margin="0 5 0 0" Foreground="Gray">是否隐藏</CheckBox>
                            </StackPanel>

                            <StackPanel x:Name="SpecialPropsContainer" Grid.Row="3" Grid.ColumnSpan="2" Margin="2,10,2,0">
                                <ContentControl x:Name="PropertyPanelHost" 
                                        Content="{Binding SelectedWidget.DataContext}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="事件绑定" Foreground="#FFD700" Margin="2,15,0,5"/>

                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="2,5" IsChecked="{Binding IsClickable}" Foreground="Gray">允许交互</CheckBox>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="2,5" IsEnabled="{Binding IsClickable}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <panels:EventPropertyPanel 
    DataContext="{Binding Source={x:Static local:SglScreen.Instance}, Path=SelectedScreen.SelectedWidgetData}" />
                            </StackPanel>

                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" x:Name="DynamicEventsHolder" Margin="10,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="字体" Foreground="#FFD700" Background="Transparent">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="10" Background="#252526">
                        <TextBlock Text="字体取模工具" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="源字体资源 (TTF/OTF):" Foreground="Gray" />

                        <ComboBox x:Name="SourceFontCombo" ItemsSource="{Binding Source={x:Static local:FontViewModel.Instance}, Path=FontTTF}" 
                          Margin="0,5" SelectedValue="{Binding FontName}" Background="#333" Foreground="White"/>

                        <UniformGrid Columns="2" Margin="0,5">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="生成名称 (C变量):" Foreground="Gray" />
                                <TextBox x:Name="FontNameBox" Text="sgl_font_16" Background="#333" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="字体大小:" Foreground="Gray" />
                                <TextBox x:Name="FontSizeBox" Text="16" Background="#333" Foreground="White"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="像素深度 (BPP):" Foreground="Gray" Margin="0,10,0,0"/>
                        <ComboBox x:Name="BppCombo" Margin="0,5" SelectedIndex="2" Background="#333">
                            <ComboBoxItem Content="1 bpp (黑白无灰度)"/>
                            <ComboBoxItem Content="2 bpp (4级灰度)"/>
                            <ComboBoxItem Content="4 bpp (16级灰度)"/>
                            <ComboBoxItem Content="8 bpp (256级灰度)"/>
                        </ComboBox>

                        <CheckBox x:Name="CheckBoxFontCompress" Content="启用RLE压缩" Foreground="Gray" Margin="0,4,0,0" IsChecked="False"/>
                        <TextBlock Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="提示: 当前 SGL 字体支持 1/2/4bpp，选择 8bpp 会自动按 4bpp 导出。启用 RLE 压缩后，运行时需打开 CONFIG_SGL_FONT_COMPRESSED；如果压缩率为负，说明压缩后反而更大，就别选择RLE压缩了"/>
                        <CheckBox x:Name="CheckBoxAscii" Content="添加ASCII" Foreground="Gray" Margin="0 10" IsChecked="True"/>
                        <TextBlock Text="包含字符 :" Foreground="Gray" Margin="0,10,0,0"/>
                        <TextBox x:Name="CustomCharsTextBox" Height="94" TextWrapping="Wrap" 
                         AcceptsReturn="True" Background="#1A1A1A" Foreground="#CE9178" 
                         Margin="0,5" VerticalScrollBarVisibility="Auto"/>

                        <Button Content="取模并加入资源库" Click="PreviewAndAdd_Click" Margin="0,15,0,5" Background="#3E3E42" Foreground="White"/>
                        <Button Content="导出 C 语言取模文件" Click="ExportFontCode_Click" Background="#007ACC" Foreground="White"/>

                        <TextBox x:Name="OutputBox" Margin="0,10,0,0" MinHeight="68"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#1A1A1A" Foreground="#9CDCFE"
                                 BorderBrush="#3E3E42" Height="122"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="图像" Foreground="#FFD700" Background="Transparent">
                <ScrollViewer   VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollerStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="ImagePanel" Background="#252526" Margin="10">
                        <TextBlock Text="图片取模 (Image)" Foreground="Gray" FontWeight="Bold"/>
                        <ComboBox x:Name="SourceImageCombo" Margin="0,5" 
                          ItemsSource="{Binding Source={x:Static local:SglResManager.Resources}}" 
                          DisplayMemberPath="Name" SelectedValuePath="Name" Background="#333" Foreground="White"/>

                        <ComboBox x:Name="ImgColorFormatCombo" Margin="0,5">
                            <ComboBoxItem Content="RGB565 (16bit)"/>
                            <ComboBoxItem Content="RGB888 (24bit)"/>
                        </ComboBox>

                        <CheckBox x:Name="IsLittleEndian" Content="小端字节序 (Little Endian)" IsChecked="True" Foreground="White" Margin="0,5"/>
                        <Button Content="测试图片取模" Click="TestImageGen_Click" Background="#3E3E42" Foreground="White" Height="30"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
