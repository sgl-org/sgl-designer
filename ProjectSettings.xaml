<Window x:Class="SglDesigner.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程设置" Height="320" Width="395" 
        xmlns:local="clr-namespace:SglDesigner"
        Background="#252525" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="NxpYellow" Color="#FFC600"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>



    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="35"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="常用预设:" Height="15"/>
        <ComboBox Grid.Column="1" Name="ComboPresets" Margin="5,5,5,5" SelectionChanged="ComboPresets_SelectionChanged">
            <ComboBoxItem Content="自定义"/>
            <ComboBoxItem Content="240 x 240 (Round/Square)"/>
            <ComboBoxItem Content="320 x 240 (QVGA)" IsSelected="True"/>
            <ComboBoxItem Content="480 x 272 (WQVGA)"/>
            <ComboBoxItem Content="480 x 480 (VGA)"/>
            <ComboBoxItem Content="800 x 480 (WVGA)"/>
            <ComboBoxItem Content="1280 x 720 (WVGA)"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Text="屏幕宽度:" Height="15"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Source={x:Static local:ProjectManager.Instance}, Path=Width}" Margin="5,5,5,5"/>

        <TextBlock Grid.Row="2" Text="屏幕高度:" Height="16"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Static local:ProjectManager.Instance}, Path=Height}" Margin="5,5,5,5"/>

        <TextBlock Grid.Row="3" Text="颜色类型:" Height="15"/>
        <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding Source={x:Static local:ProjectManager.Instance}, Path=ColorFormat,Converter={StaticResource ColorFormatIndexConverter}}" Margin="5,5,5,5">
            <ComboBoxItem Content="16-bit (RGB565)"/>
            <ComboBoxItem Content="32-bit (RGB888)"/>
        </ComboBox>

        <TextBlock Text="代码导出路径:" Grid.Row="4" Foreground="White" Height="15"></TextBlock>
        <StackPanel  Grid.Row="4" Margin="5" Grid.Column="1" Orientation="Horizontal"  >
            <TextBox Width="210" Height="24"   Text="{Binding Source={x:Static local:ProjectManager.Instance}, Path=ExportFolder}" ></TextBox>
            <Button Content="浏览" Width="40" Name="Browser" Click="Browser_Click" Margin="0 0 0 0" Height="24" IsCancel="True" Background="#444" Foreground="White" BorderThickness="0"/>
        </StackPanel>
        <UniformGrid Grid.Row="6" Columns="2" HorizontalAlignment="Left" Grid.Column="1" Width="270">
            <Button Content="应用设置" Width="80" Click="Ok_Click" IsDefault="True" Margin="0,0,10,0" 
                    Background="{StaticResource NxpYellow}" Foreground="Black" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="取消" Width="80" IsCancel="True" Background="#444" Foreground="White" BorderThickness="0"/>
        </UniformGrid>
    </Grid>
</Window>